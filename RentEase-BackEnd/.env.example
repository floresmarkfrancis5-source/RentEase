# Copy this file to .env and update the values below
# NEVER commit your real .env file (it is already in .gitignore)

# Application Settings
APP_NAME=RentEaseAPI
APP_KEY=
APP_ENV=development

# Database Configuration  (local XAMPP/MySQL example - for Aiven see the notes below)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rentease_db
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL=false
DB_CONNECT_TIMEOUT=5
# Temporarily enable safe per-query timings for the landlord dashboard (no SQL or values logged).
DASHBOARD_QUERY_TIMING=false

# --- Aiven MySQL (copy these values from the Aiven console -> Connection information) ---
# DB_HOST=your-service.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=defaultdb
# DB_SSL=true
# On your own PC you can point to the downloaded ca.pem file:
# DB_SSL_CA=C:/path/to/ca.pem
# On Render paste the whole PEM text (with real line breaks) into DB_SSL_CA_CONTENT instead.

# For API (generate with: php lava jwt:generate   -> fills these two automatically)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend origin(s) allowed to call this API (comma separated). Use * only for testing.
CORS_ORIGIN=http://localhost:5173
# Public URL of the React app (used for PayMongo return links and the buttons in e-mails)
FRONTEND_URL=http://localhost:5173

# Database migrations: true on your PC while doing the migration lab,
# leave it false/unset on the deployed Render server.
MIGRATION_ENABLED=true

# --- PayMongo (online rent payment; use TEST keys) -----------------------------
# Dashboard -> Developers -> API Keys, and Developers -> Webhooks (event: checkout_session.payment.paid)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=card,gcash,paymaya
# Live payments are not supported. The backend accepts only sk_test_ keys.
PAYMONGO_FORCE_TEST_PISO=true

# --- Google sign-in (OAuth) ------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# --- First platform superadmin (migration 018 only; configure privately before migrating) ---
# Set unique private values before running migration 018. Blank values intentionally prevent demo credentials.
SUPERADMIN_BOOTSTRAP_EMAIL=
SUPERADMIN_BOOTSTRAP_USERNAME=
SUPERADMIN_BOOTSTRAP_FULL_NAME=
SUPERADMIN_BOOTSTRAP_PASSWORD=

# --- Gemini rental assistant (server-side key; never add it to the frontend) ---------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_DEBUG=false

# --- E-mail (PHPMailer / SMTP). Render Free blocks SMTP ports 25, 465, and 587. ---
# Use an HTTPS email provider or a paid Render service for SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=RentEase

# --- Scheduled reminders: a Render Cron Job calls POST /api/cron/reminders with header X-Cron-Token ---
CRON_TOKEN=

# --- Cloudinary Image CDN (free global asset storage for property/unit photos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
