# URL of the LavaLust API (no trailing slash).
# Local:   http://localhost:3000   (php lava serve)
# Render:  https://delavega-prince-viel-lavalust-backend.onrender.com
VITE_API_URL=http://localhost:3000

# Optional: Google sign-in button on the login page (same client id as the API's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Maps embed on property pages. Leave empty to use plain map links instead.
VITE_GOOGLE_MAPS_KEY=
